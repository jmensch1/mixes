# Audio: kept beside the sets, not in git (gigabytes; Time Machine backs it up)
*.wav
*.aif
*.aiff
*.mp3
*.m4a
*.flac
*.caf

# Ableton: waveform caches, its own backups of each save, and audio it renders
*.asd
Backup/
Samples/

# Logic: the audio inside a project, its own backups, undo and autosave data
# (**/ so they match at any depth: a pattern with a slash in it is otherwise tied to this folder)
**/*.logicx/Media/
**/*.logicx/Alternatives/*/Project File Backups/
**/*.logicx/Alternatives/*/Undo Data.nosync/
**/*.logicx/Alternatives/*/Autosave/

# Analysis by-products
*.npz
__pycache__/
.venv/
.DS_Store

# Claude Code: this Mac's own permissions
.claude/settings.local.json
